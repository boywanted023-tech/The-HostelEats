NODE_ENV=development
PORT=5000

JWT_SECRET=replace_with_a_strong_256_bit_random_string_for_jwt_signing
REFRESH_SECRET=replace_with_another_strong_256_bit_random_string_for_refresh_tokens
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

MONGODB_URI=mongodb://127.0.0.1:27017/hosteleats
DB_ENCRYPTION_KEY=replace_with_a_32_byte_key_for_field_encryption
ENABLE_FIELD_LEVEL_ENCRYPTION=false

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

TRUST_PROXY=false
IP_BLACKLIST_ENABLED=false

TWO_FACTOR_ENABLED=false
TWO_FACTOR_ISSUER=HostelEats

REQUEST_SIGNING_SECRET=replace_with_request_signing_secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

ADMIN_EMAIL=admin@hosteleats.com
ADMIN_PASSWORD=SuperSecure@2024!

SEED_DB=true

SURGE_START_HOUR=19
SURGE_END_HOUR=21
SURGE_CHARGE=10